# Render runtime
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=10000

# Render PostgreSQL (use the individual values shown under Connections)
DB_HOST=REPLACE_WITH_INTERNAL_HOSTNAME
DB_NAME=petcare
DB_USERNAME=REPLACE_WITH_DATABASE_USERNAME
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JPA_DDL_AUTO=update

# Authentication (generate a new Base64 secret in Render)
JWT_SECRET=REPLACE_WITH_A_SECURE_BASE64_SECRET
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend
FRONTEND_URL=https://pabloyman-01.github.io/PetCare-Frontend

# Email is optional for the initial deployment
# MAILGUN_API_KEY=REPLACE_WITH_MAILGUN_API_KEY
# MAILGUN_DOMAIN=REPLACE_WITH_MAILGUN_DOMAIN
# MAIL_FROM=PetCare <noreply@example.com>
